# JalRakshak Backend Environment Variables
# Copy this file to .env and fill in the values for production

# Environment (development/production)
ENVIRONMENT=development

# CORS Configuration
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Trusted Hosts (production only)
# Comma-separated list of allowed hostnames
ALLOWED_HOSTS=localhost,127.0.0.1

# API Key Authentication (optional)
# Set this to enable API key authentication
# Leave empty to disable authentication (development mode)
API_KEY=

# Rate Limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=60

# Model Integrity Verification (optional)
# Set these to enable SHA256 hash verification for model files
# Generate with: sha256sum models/demand_model.joblib
DEMAND_MODEL_HASH=
SUPPLY_MODEL_HASH=

# Data Paths (optional, defaults provided)
MASTER_DATA_PATH=data/final/jalrakshak_master.csv
